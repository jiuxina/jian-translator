npm-debug.log*
yarn-error.log*

# Android machine configuration, caches and signing credentials
android/.gradle/
android/build/
android/app/build/
**/build/
android/local.properties
android/signing.properties
android/keystore/
*.keystore
*.jks
.idea/
.vscode/
.env
.env.local

# Keep release checksums, but not generated packages or preview media
output/*
!output/SHA256SUMS.txt
