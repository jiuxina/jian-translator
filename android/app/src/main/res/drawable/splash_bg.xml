<?xml version="1.0" encoding="utf-8"?>
<!-- 启动闪屏：与主题的 lg-bg / lg-bg-warm 同一套环境柔光，避免冷启动跳成纯白 -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="#FCF8FB"
                android:centerColor="#F3EFF6"
                android:endColor="#EFEAF6" />
        </shape>
    </item>
    <item
        android:width="76dp"
        android:height="76dp"
        android:gravity="center">
        <bitmap android:src="@mipmap/ic_launcher" />
    </item>
</layer-list>
